# Supabase project settings (client-side anon key only; never put service-role keys here)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI provider configuration. Keep provider secrets on a trusted server, not in Vite client variables.
AI_PROVIDER=your-provider
AI_API_KEY=server-side-secret-configured-outside-this-repository

# Mapping provider. Configure only if an approved provider is selected.
VITE_MAP_PROVIDER=your-map-provider
VITE_MAP_PUBLIC_TOKEN=your-public-map-token
